# Copy to .env (bin/init.sh does this) and edit.

# The address the service answers on, without https://
BG_DOMAIN=crm.example.org
# Email for Let's Encrypt certificate notices.
BG_ACME_EMAIL=admin@example.org
# 0 = organizations at crm.example.org/org-name/ (simplest)
# 1 = organizations at org-name.crm.example.org (needs a wildcard certificate)
BG_SUBDOMAINS=0

# Operator mail relay, used by the network and by any organization that has
# not entered its own relay in BosqueGrande. Put the password in
# secrets/smtp_password. BG_MAIL_FROM must be an address the relay may send
# as; replies still go to each organization.
BG_SMTP_HOST=
BG_SMTP_PORT=587
BG_SMTP_SECURE=tls
BG_SMTP_USER=
BG_MAIL_FROM=

# Network administrator created by bin/install.sh
BG_NETWORK_TITLE=BosqueGrande
BG_ADMIN_USER=operator
BG_ADMIN_EMAIL=admin@example.org

# Pin these to exact versions or digests in production.
WP_IMAGE=wordpress:php8.3-apache
DB_IMAGE=mariadb:11.4
CADDY_IMAGE=caddy:2
